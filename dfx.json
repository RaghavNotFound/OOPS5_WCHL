{
  "canisters": {
    "verichain_frontend": {
      "type": "assets",
      "source": [
        "frontend/.next"
      ],
      "build": [
        "cd frontend && npm install && npm run build"
      ]
    },
    "verichain_backend": {
      "main": "backend/motoko/main.mo",
      "type": "motoko"
    }
  },
  "defaults": {
    "build": {
      "packtool": "mops",
      "args": ""
    }
  },
  "networks": {
    "playground": {
      "providers": ["https://icp0.io"],
      "type": "persistent"
    }
  },
  "profiles": {
    "release": {
      "version": "1.0.0"
    }
  }
}